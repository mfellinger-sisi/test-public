# Projekteigene PHPStan-Konfiguration (hat in der CI Vorrang vor .aicrew/phpstan-server.neon).
# Analysiert die tatsaechlich vorhandenen PHP-Pfade des Projekts (Deployment-Skripte
# unter Build/). Kommt eine eigene Extension bzw. ein Sitepackage dazu (extensions/
# oder packages/), den Pfad unter "paths" ergaenzen.
#
# Voraussetzung: "composer install" ist gelaufen (in der CI liefert der Composer-Job
# vendor/ als Artefakt). Klassen von TYPO3, Doctrine & Co. werden aus vendor/ geladen;
# fehlende Klassen werden bewusst gemeldet und nicht ausgeblendet.
parameters:
    level: 8
    paths:
        - %currentWorkingDirectory%/Build
    bootstrapFiles:
        - %currentWorkingDirectory%/vendor/autoload.php
    excludePaths:
        analyse:
            - */vendor/*
            - */node_modules/*
