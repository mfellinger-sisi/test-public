# Generated by composer / the TYPO3 composer installers
/vendor/
/index.php
/typo3/
/_assets/

# Runtime data of the installation (per environment, never in git)
/fileadmin/
/typo3temp/
/uploads/
/var/

# Written by the CI deployment (database credentials from DEPLOY_DATABASE_URL)
/config/

# Configuration written by TYPO3 itself (database credentials, encryption key,
# install tool password). Only the site configuration below is versioned.
/typo3conf/*
!/typo3conf/sites/
/typo3conf/sites/*/*.bak

# Reports of the CI checks
/.reports/
