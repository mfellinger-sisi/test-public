# Generated by composer / the TYPO3 composer installers
/vendor/

# Web root: only the .htaccess is versioned. index.php, typo3/, _assets/,
# fileadmin/, typo3temp/ and uploads/ are generated or created per environment.
/public/*
!/public/.htaccess

# Runtime data of the installation (logs, cache, SQLite database, initial
# password) - per environment, never in git
/var/

# Configuration written by TYPO3 itself (database credentials, encryption key,
# install tool password) and by the CI deployment (DEPLOY_DATABASE_URL). Only
# the site configuration in config/sites/ is versioned.
/config/system/
/config/sites/*/*.bak

# Reports of the CI checks
/.reports/
